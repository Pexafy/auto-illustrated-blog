PEXAFY_API_KEY=pexafy_...       # free key: https://pexafy.com/dashboard/api-keys/create/

# The model that writes the post, as provider:model. Default: anthropic:claude-haiku-4-5
# MODEL=openai:gpt-5.4-mini
# MODEL=google:gemini-3.5-flash
# MODEL=local:qwen3:8b             # any OpenAI-compatible server, Ollama by default

# The key for that provider: its usual variable, or MODEL_API_KEY for any of them.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# MODEL_API_KEY=...

# For MODEL=local:…, the server's OpenAI-compatible address (default: Ollama).
# LOCAL_BASE_URL=http://localhost:11434/v1
